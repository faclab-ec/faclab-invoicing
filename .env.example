# Copy to .env for local development: `npm run dev` and `npm start` load it when it exists.
# Without NODE_ENV the service runs in local mode, and every variable has a default that
# points at faclab-infra from the host. With NODE_ENV=production the ones marked
# "required in production" have no default and the process refuses to start without them.

# local (default) or production
# NODE_ENV=local

# The SRI environment is a setting of each issuer (PUT /api/company-config, `environment`): local only
# reaches the test web services (celcer), production both.

# Kafka brokers, comma-separated. Required in production. A container on faclab_network uses kafka:9092.
# KAFKA_BROKERS=localhost:29092

# PostgreSQL: faclab-infra's invoicing-db (a container on faclab_network uses invoicing-db:5432).
# Required in production. The service defaults to this value in local, but `npm run migrate` only
# reads the variable, so keep it here.
DATABASE_URL=postgres://faclab_invoicing:faclab_invoicing@localhost:5434/faclab_invoicing

# The PostgreSQL tests (test/postgres) read TEST_DATABASE_URL from the shell, not from this file:
# TEST_DATABASE_URL=postgres://faclab_invoicing:faclab_invoicing@localhost:5434/faclab_invoicing_test npm test

# Origins allowed to call the API (faclab-web), comma-separated. Required in production, without *.
# CORS_ORIGINS=http://localhost:5173

# faclab-core's JWT_SECRET (required in production, 32+ characters) and issuer.
# JWT_SECRET=
# JWT_ISSUER=faclab-core

# 32 random bytes in base64 (`openssl rand -base64 32`); encrypts the certificate passwords.
# Required in production; changing it makes the stored certificates unreadable.
# CERTIFICATE_PASSWORD_KEY=

# S3-compatible object storage for the authorized invoices. Local defaults: faclab-infra's
# object-storage (Garage) at http://localhost:3900, region garage, bucket faclab-invoicing and its
# development key. Region, bucket and key are required in production; an empty endpoint means AWS.
# OBJECT_STORAGE_ENDPOINT=http://localhost:3900
# OBJECT_STORAGE_REGION=garage
# OBJECT_STORAGE_BUCKET=faclab-invoicing
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Invoicing rules the accountant may change (D-4): the emission date (sale: when faclab-core asked to
# invoice the sale; prepared: when the XML is built) and the highest total in USD of an invoice to
# the final consumer
# INVOICE_EMISSION_DATE=sale
# FINAL_CONSUMER_MAX_TOTAL=50

# RUC of whoever runs Faclab, written in every invoice as "RUC Proveedor" (ficha técnica, Anexo 26).
# Set it in production.
# INVOICING_PROVIDER_RUC=

# Development only (refused in production): the company (faclab-core tenant id) that invoices
# sales.confirmed v1, which names none. Without it a v1 message is kept as a dead letter.
# SALES_V1_TENANT_ID=

# Optional
# HTTP_PORT=3173
# LOG_LEVEL=debug
# SRI_TIMEOUT_MS=30000
# INVOICE_RETRY_INTERVAL_MS=60000

# The worker (S4.2). RUN_BACKGROUND=false leaves the consumer and the worker to `npm run worker`;
# true (the default) runs them in the API process too. Each worker takes up to
# INVOICE_WORKER_CONCURRENCY invoices at once (at most 8), looks for work every
# INVOICE_POLL_INTERVAL_MS and holds each invoice for INVOICE_LOCK_TIMEOUT_MS (at least twice
# SRI_TIMEOUT_MS) before another worker may take it
# RUN_BACKGROUND=true
# INVOICE_WORKER_CONCURRENCY=4
# INVOICE_POLL_INTERVAL_MS=1000
# INVOICE_LOCK_TIMEOUT_MS=120000

# Delivery of authorized invoices to their buyers (S4.4): RIDE and email through any SMTP server
# (D-3). Locally the defaults point at faclab-infra's Mailpit (it keeps the emails at
# http://localhost:8025 and delivers none); a container on faclab_network uses SMTP_HOST=mailpit.
# In production SMTP_HOST and INVOICE_EMAIL_FROM are required unless INVOICE_EMAIL_ENABLED=false,
# the rollback: deliveries then only keep the RIDE. SMTP_USER and SMTP_PASSWORD go together;
# SMTP_SECURE=true for TLS from the start (465), otherwise production requires STARTTLS.
# INVOICE_LOCK_TIMEOUT_MS must be at least three times SMTP_TIMEOUT_MS; INVOICE_DELIVERY_CONCURRENCY
# (1 to 4) plus INVOICE_WORKER_CONCURRENCY, at most 8
# INVOICE_EMAIL_ENABLED=true
# INVOICE_EMAIL_FROM=facturas@faclab.local
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TIMEOUT_MS=20000
# INVOICE_DELIVERY_CONCURRENCY=2

# Tag or commit SHA in logs, traces and the API docs; the production image sets it at build time
# SERVICE_VERSION=dev

# OpenTelemetry, read by src/instrumentation.ts. The default endpoint is SigNoz local's collector as
# seen from the host (faclab-infra `scripts/signoz.sh up`); a container on faclab_network uses
# http://signoz-otel-collector:4317. OTEL_SDK_DISABLED=true turns it off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true
