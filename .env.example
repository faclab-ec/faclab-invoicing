# Copy to .env for local development: `npm run dev` and `npm start` load it when it exists.
# Without NODE_ENV the service runs in local mode, and every variable has a default that
# points at faclab-infra from the host. With NODE_ENV=production the ones marked
# "required in production" have no default and the process refuses to start without them.

# local (default) or production
# NODE_ENV=local

# SRI web services: test (celcer) or production (cel). Required in production; local only allows test.
# SRI_ENVIRONMENT=test

# Kafka brokers, comma-separated. Required in production. A container on faclab_network uses kafka:9092.
# KAFKA_BROKERS=localhost:29092

# PostgreSQL: faclab-infra's invoicing-db (a container on faclab_network uses invoicing-db:5432).
# Required in production. The service defaults to this value in local, but `npm run migrate` only
# reads the variable, so keep it here.
DATABASE_URL=postgres://faclab_invoicing:faclab_invoicing@localhost:5434/faclab_invoicing

# The PostgreSQL tests (test/postgres) read TEST_DATABASE_URL from the shell, not from this file:
# TEST_DATABASE_URL=postgres://faclab_invoicing:faclab_invoicing@localhost:5434/faclab_invoicing_test npm test

# Origins allowed to call the API (faclab-web), comma-separated. Required in production, without *.
# CORS_ORIGINS=http://localhost:5173

# faclab-core's JWT_SECRET (required in production, 32+ characters) and issuer.
# JWT_SECRET=
# JWT_ISSUER=faclab-core

# 32 random bytes in base64 (`openssl rand -base64 32`); encrypts the certificate passwords.
# Required in production; changing it makes the stored certificates unreadable.
# CERTIFICATE_PASSWORD_KEY=

# Optional
# HTTP_PORT=3173
# LOG_LEVEL=debug
# SRI_TIMEOUT_MS=30000
# INVOICE_RETRY_INTERVAL_MS=60000

# Tag or commit SHA in logs, traces and the API docs; the production image sets it at build time
# SERVICE_VERSION=dev

# OpenTelemetry, read by src/instrumentation.ts. The default endpoint is SigNoz local's collector as
# seen from the host (faclab-infra `scripts/signoz.sh up`); a container on faclab_network uses
# http://signoz-otel-collector:4317. OTEL_SDK_DISABLED=true turns it off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true
