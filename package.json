{
  "name": "faclab-invoicing",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/ts-node-dev/lib/bin.js -T --exit-child -r tsconfig-paths/register -r ./src/instrumentation.ts src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists=.env -r ./dist/instrumentation.js dist/server.js",
    "dev:worker": "node --env-file-if-exists=.env node_modules/ts-node-dev/lib/bin.js -T --exit-child -r tsconfig-paths/register -r ./src/instrumentation.ts src/worker.ts",
    "worker": "node --env-file-if-exists=.env -r ./dist/instrumentation.js dist/worker.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:postgres": "vitest run test/postgres",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations",
    "contracts:sync": "scripts/sync-contracts.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@confluentinc/kafka-javascript": "^1.8.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/swagger": "^9.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/instrumentation-pg": "^0.66.0",
    "@opentelemetry/instrumentation-pino": "^0.60.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@scalar/fastify-api-reference": "^1.49.3",
    "@xmldom/xmldom": "^0.8.11",
    "axios": "^1.13.6",
    "bwip-js": "^4.11.4",
    "fastify": "^5.8.2",
    "luxon": "^3.7.2",
    "node-forge": "^1.3.3",
    "node-pg-migrate": "^9.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "strong-soap": "^4.1.14",
    "uuid": "^11.1.1",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^3.1.1",
    "xmllint-wasm": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.15",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "ajv": "^8.18.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^1.6.1"
  }
}
