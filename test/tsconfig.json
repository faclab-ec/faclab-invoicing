{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "baseUrl": "..",
    "types": ["node"],
    // Resolved as vitest loads them: node-pg-migrate only publishes its types through `exports`
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["../src", "."]
}
